# Copy to .env.local and fill in from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# .env.local is gitignored. Mirror these same values into the Vercel project's
# Environment Variables or the deployed build will come up with no data.

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon / public" key. Safe to expose in the browser bundle — row-level
# security is what constrains it. See supabase/migrations/0002_rls.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The project ref (the subdomain of the URL above). Used only by
# `npm run db:types` to regenerate lib/types/database.ts.
SUPABASE_PROJECT_ID=

# The "service_role" key bypasses row-level security entirely.
# NEVER prefix this with NEXT_PUBLIC_ and never reference it in a Client
# Component. Only needed if you add the audio-ingest pipeline.
# SUPABASE_SERVICE_ROLE_KEY=
